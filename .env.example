# Password for the Liseo web UI. This is not the ByteBooks password.
LISEO_ADMIN_PASSWORD=change-me-please

# Encrypts the Adobe activation files stored in the /data volume.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
LISEO_SECRET_KEY=change-me-please-use-a-long-random-string

# Comma-separated hosts accepted from a .acsm operatorURL.
LISEO_ALLOWED_OPERATORS=acs4.edenlivres.fr

# Public origin of the UI. http://localhost is a secure context.
# A NAS name over plain HTTP is not: the file picker will refuse to open.
LISEO_PUBLIC_URL=http://localhost:8080

TZ=Europe/Paris
